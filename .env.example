PORT=3000
NODE_ENV=development
SERVE_TEST_UI=true

# Allowed origins for browser clients. Separate multiple origins with comma.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost,https://localhost,capacitor://localhost

# Request body size limit for JSON endpoints.
API_BODY_LIMIT=10mb

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Cloudflare R2 Storage
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=syntrix-storage
R2_PUBLIC_URL=https://your-r2-domain.r2.cloudflarestorage.com

# Firebase Auth (Spark Plan)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_service_account_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_WEB_API_KEY=your_firebase_web_api_key

# JWT Token
JWT_SECRET=syntrix-dev-jwt-secret-2026

DEFAULT_STORAGE_BUCKET=default
MAX_UPLOAD_SIZE_MB=25
IMAGE_UPLOAD_MAX_SIZE_MB=5

# Rate limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=25
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=500

# Import hardening
IMPORT_MAX_ROWS=2000
IMPORT_ALLOWED_ENTITIES_ADMIN=devices,pops,projects,regions
IMPORT_ALLOWED_ENTITIES_USER_ALL_REGION=devices,pops,projects
IMPORT_ALLOWED_ENTITIES_USER_REGION=devices,pops

# Used only for initial admin bootstrap. Rotate after first use.
BOOTSTRAP_ADMIN_SECRET=change_this_bootstrap_secret

# Validation workflow rollout controls
VALIDATION_WORKFLOW_ENABLED=true
# Comma-separated public.regions.id values for pilot rollout.
# Empty means all regions are allowed.
VALIDATION_WORKFLOW_ALLOWED_REGION_IDS=

# Optional smoke test values for CI/local scripts
SMOKE_BASE_URL=http://127.0.0.1:3000
SMOKE_ADMIN_EMAIL=admin@syntrix.local
SMOKE_ADMIN_PASSWORD=AdminKuat123!

# Optional validation workflow test users
VALIDATION_TEST_SUPERADMIN_EMAIL=superadmin.test@syntrix.local
VALIDATION_TEST_SUPERADMIN_PASSWORD=Syntrix@12345
VALIDATION_TEST_ADMINREGION_EMAIL=adminregion.test@syntrix.local
VALIDATION_TEST_ADMINREGION_PASSWORD=Syntrix@12345
VALIDATION_TEST_VALIDATOR_EMAIL=validator.test@syntrix.local
VALIDATION_TEST_VALIDATOR_PASSWORD=Syntrix@12345
